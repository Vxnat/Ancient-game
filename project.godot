; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Project Origin"
config/description="2D Pixel Art Action-Platformer / Metroidvania - Science Fantasy"
run/main_scene="res://world/peaceful_planet/peaceful_village.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")

[autoload]

EventBus="*res://autoloads/event_bus.gd"
AudioManager="*res://autoloads/audio_manager.gd"
GameManager="*res://autoloads/game_manager.gd"
SceneManager="*res://autoloads/scene_manager.gd"
QuestManager="*res://autoloads/quest_manager.gd"
SaveManager="*res://autoloads/save_manager.gd"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="viewport"

